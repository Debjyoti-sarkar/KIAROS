# ── AI (one key required) ───────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# If both are set Gemini is used; force one with LLM_PROVIDER=gemini|anthropic
# LLM_PROVIDER=
# Offline backup: a local model via Ollama (install: scripts/install-ollama.sh).
# Used automatically when the cloud is out of quota or unreachable; with no cloud key it's the only brain.
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BACKUP=1          # 0 turns the backup off
# OLLAMA_URL=http://127.0.0.1:11434
# Gemini models are picked automatically (newest Flash for talk, Pro for research):
# GEMINI_FAST_MODEL=
# GEMINI_DEEP_MODEL=

# ── You ─────────────────────────────────────────────────────────────────────
USER_NAME=
# How KIAROS addresses you: sir, ma'am, boss, or empty for name only
HONORIFIC=sir
# Weather location (empty = detect from your IP), e.g. Kolkata
WEATHER_LOCATION=

# ── Voice (optional) ────────────────────────────────────────────────────────
# Fish Audio for a premium voice. Leave empty to use each device's built-in voice.
FISH_API_KEY=
FISH_VOICE_ID=

# ── Calendar (optional, read-only) ──────────────────────────────────────────
# ICS links or .ics file paths, comma-separated.
# Google Calendar: Settings → your calendar → "Secret address in iCal format"
CALENDAR_ICS_URLS=

# ── Email (optional, READ-ONLY over IMAP) ───────────────────────────────────
# Gmail: create an app password at https://myaccount.google.com/apppasswords
MAIL_IMAP_HOST=imap.gmail.com
MAIL_ADDRESS=
MAIL_APP_PASSWORD=

# ── Notes ───────────────────────────────────────────────────────────────────
# Folder for Markdown notes (default: ~/Documents/KIAROS Notes)
NOTES_DIR=

# ── Server ──────────────────────────────────────────────────────────────────
# Pairing token for your phone. Generated automatically on first start.
KIAROS_TOKEN=
# KIAROS_PORT=8340          # HTTP: laptop + Android app
# KIAROS_HTTPS_PORT=8341    # HTTPS: phone browser (needs cert.pem/key.pem)
# KIAROS_PROJECTS_DIR=~/Desktop   # where Claude Code builds new projects
# KIAROS_TERMINAL=gnome-terminal

# ── Models (optional overrides) ─────────────────────────────────────────────
# KIAROS_FAST_MODEL=claude-haiku-5-5
# KIAROS_DEEP_MODEL=claude-opus-5-5
